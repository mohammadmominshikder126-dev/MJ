# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase service role key (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN_PASSCODE: Passcode for /Admin/login/mj (optional; claim inline on first run if blank)
ADMIN_PASSCODE=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
