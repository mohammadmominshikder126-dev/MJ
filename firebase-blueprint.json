{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global A-to-Z portfolio configuration for branding, banner, headings, about, service cards, WhatsApp, Telegram group, and footer.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "brandSubtitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "logoUrl": { "type": "string", "maxLength": 350000 },
        "hireButtonText": { "type": "string", "minLength": 1, "maxLength": 40 },
        "availabilityText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bannerGreeting": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bannerHighlight": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bannerSubtitle": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bannerDescription": { "type": "string", "minLength": 1, "maxLength": 300 },
        "bannerImageUrl": { "type": "string", "maxLength": 350000 },
        "portfolioCtaText": { "type": "string", "minLength": 1, "maxLength": 40 },
        "contactCtaText": { "type": "string", "minLength": 1, "maxLength": 40 },
        "skillsHeading": { "type": "string", "minLength": 1, "maxLength": 60 },
        "portfolioHeading": { "type": "string", "minLength": 1, "maxLength": 60 },
        "portfolioSubheading": { "type": "string", "minLength": 1, "maxLength": 120 },
        "aboutTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "aboutDescription": { "type": "string", "minLength": 1, "maxLength": 500 },
        "aboutImageUrl": { "type": "string", "maxLength": 350000 },
        "quickCard1Title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "quickCard1Subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quickCard2Title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "quickCard2Subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quickCard3Title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "quickCard3Subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 20, "pattern": "^[0-9+\\-\\s]{7,20}$" },
        "whatsappGreeting": { "type": "string", "minLength": 1, "maxLength": 160 },
        "telegramGroupUrl": { "type": "string", "maxLength": 240 },
        "facebookUrl": { "type": "string", "maxLength": 240 },
        "youtubeUrl": { "type": "string", "maxLength": 240 },
        "githubUrl": { "type": "string", "maxLength": 240 },
        "linkedinUrl": { "type": "string", "maxLength": 240 },
        "footerRightsText": { "type": "string", "minLength": 1, "maxLength": 120 },
        "footerCreditText": { "type": "string", "minLength": 1, "maxLength": 120 },
        "privacyPolicyText": { "type": "string", "minLength": 1, "maxLength": 800 },
        "termsText": { "type": "string", "minLength": 1, "maxLength": 800 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": [
        "brandName",
        "brandSubtitle",
        "logoUrl",
        "hireButtonText",
        "availabilityText",
        "bannerGreeting",
        "bannerHighlight",
        "bannerSubtitle",
        "bannerDescription",
        "bannerImageUrl",
        "portfolioCtaText",
        "contactCtaText",
        "skillsHeading",
        "portfolioHeading",
        "portfolioSubheading",
        "aboutTitle",
        "aboutDescription",
        "aboutImageUrl",
        "quickCard1Title",
        "quickCard1Subtitle",
        "quickCard2Title",
        "quickCard2Subtitle",
        "quickCard3Title",
        "quickCard3Subtitle",
        "whatsappNumber",
        "whatsappGreeting",
        "telegramGroupUrl",
        "facebookUrl",
        "youtubeUrl",
        "githubUrl",
        "linkedinUrl",
        "footerRightsText",
        "footerCreditText",
        "privacyPolicyText",
        "termsText",
        "updatedAt",
        "updatedBy"
      ]
    },
    "Skill": {
      "title": "Skill",
      "description": "Developer skill badge displayed in My Skills section.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "minLength": 1, "maxLength": 60 },
        "iconKey": { "type": "string", "minLength": 1, "maxLength": 30 },
        "order": { "type": "number" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "iconKey", "order", "authorId", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio website project with category, description, features, live URL, and screenshot.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["business", "ecommerce", "web-apps"] },
        "categoryLabel": { "type": "string", "enum": ["Business", "E-Commerce", "Web Apps"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "longDescription": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "year": { "type": "string", "minLength": 4, "maxLength": 10 },
        "techStack": { "type": "array", "description": "Up to 10 technology tags." },
        "highlights": { "type": "array", "description": "Up to 12 website feature descriptions." },
        "previewType": { "type": "string", "enum": ["portfolio", "ecommerce", "business", "custom"] },
        "liveUrl": { "type": "string", "maxLength": 300 },
        "thumbnailUrl": { "type": "string", "maxLength": 350000 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "categoryLabel",
        "description",
        "longDescription",
        "year",
        "techStack",
        "highlights",
        "previewType",
        "liveUrl",
        "thumbnailUrl",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized portfolio administrator record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Singleton public A-to-Z site configuration document (configId = 'main')."
    },
    "/skills/{skillId}": {
      "schema": { "$ref": "#/entities/Skill" },
      "description": "Real-time managed developer skills publicly readable and admin-writable."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Portfolio website projects publicly readable and writable only by verified Admin."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role documents readable by owner/admin and writable only by existing admin."
    }
  }
}
